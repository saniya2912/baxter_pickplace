<!-- ============================================================================
  g1_twoblocks.xml — Unitree G1 (single right arm only) + two coloured blocks.

  Scene geometry (table, blocks, cameras, floor) is an exact copy of
  baxter_twoblocks.xml so the same six-task language template
  ("move the {color} block to the {near/far} side") applies unchanged
  across embodiments.

  Design decisions (per project scoping discussion):
    - Lower body locked: no freejoint, no leg joints, no waist joints.
      Pelvis/waist/torso are fused into one static mount at a fixed
      pedestal height chosen so the arm's workspace covers the table
      (same table position as the Baxter/Franka scenes).
    - Only the right arm is used for tasks — single-arm control, matching
      Baxter/Franka. The left arm is present but purely for visual
      completeness: it's actuated and held fixed at G1's stock "stand"
      resting pose, and its actuators/qpos are deliberately appended
      LAST so they sit outside the task's action/state space (only the
      first 7+2 actuators — right arm + gripper — are used for data
      collection/training).
    - Native Dex3 hand (right) replaced with a simplified 1-DOF parallel
      gripper — the same Rethink gripper subtree used in
      baxter_twoblocks.xml (meshes/rethink_gripper), reused as-is for
      design consistency across embodiments. The left hand keeps the
      stock visual-only "rubber_hand" mesh (no gripper, unused).

  Arm/torso kinematics + meshes from mujoco_menagerie's unitree_g1/g1.xml
  (Apache-2.0 / BSD-3, see meshes/g1/LICENSE).

  qpos order (37 values, nv=34):
    cube_red_free  (7): x y z qw qx qy qz
    cube_blue_free (7): x y z qw qx qy qz
    cube_green_free(7): x y z qw qx qy qz
    right arm      (7): shoulder_pitch shoulder_roll shoulder_yaw elbow
                         wrist_roll wrist_pitch wrist_yaw
    right gripper  (2): l_finger r_finger
    left arm       (7): visual-only, not used for tasks

  ctrl order (16 values):
    right arm(7) | right gripper l,r (2) | left arm(7, visual-only)
    — only the first 9 actuators are part of the task action space.
============================================================================ -->
<mujoco model="g1_twoblocks">

  <compiler angle="radian" meshdir="/home/robotlab/Desktop/saniya_ws/pi0.5_mujoco/models/meshes" autolimits="true"/>

  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.8 0.8 0.8" specular="0.1 0.1 0.1"/>
    <global offwidth="1280" offheight="720"/>
  </visual>

  <default>
    <default class="g1">
      <joint armature="0.01" frictionloss="0.3"/>
      <position kp="500" dampratio="1" inheritrange="1"/>
      <default class="visual">
        <geom group="2" type="mesh" contype="0" conaffinity="0" density="0" material="metal"/>
      </default>
      <default class="collision">
        <!-- contype/conaffinity=0: disabled rather than menagerie's default
             (1,1). Upstream this drives whole-body self-collision (arm vs
             torso, leg vs leg); here the torso/legs are fixed and we don't
             need that fidelity, and leaving it on blocked the shoulder from
             reaching several pregrasp poses (self-collision with the torso
             partway through the reach). The gripper's own finger_col /
             explicit-contype geoms are unaffected and still collide with
             the table and blocks normally. -->
        <geom group="3" type="mesh" contype="0" conaffinity="0"/>
      </default>
    </default>
    <!-- Rethink parallel-jaw gripper, reused verbatim from baxter_twoblocks.xml -->
    <default class="visual_gripper">
      <geom contype="0" conaffinity="0"/>
    </default>
    <default class="finger_col">
      <geom contype="2" conaffinity="5" rgba="0.1 0.1 0.1 0" friction="0.8 0.1 0.1"/>
    </default>
  </default>

  <asset>
    <material name="black" rgba="0.2 0.2 0.2 1"/>
    <material name="metal" rgba="0.7 0.7 0.7 1"/>

    <mesh name="pelvis_mesh"      file="g1/pelvis.STL"/>
    <mesh name="pelvis_contour"   file="g1/pelvis_contour_link.STL"/>
    <mesh name="waist_yaw_mesh"   file="g1/waist_yaw_link_rev_1_0.STL"/>
    <mesh name="waist_roll_mesh"  file="g1/waist_roll_link_rev_1_0.STL"/>
    <mesh name="torso_mesh"       file="g1/torso_link_rev_1_0.STL"/>
    <mesh name="logo_mesh"        file="g1/logo_link.STL"/>
    <mesh name="head_mesh"        file="g1/head_link.STL"/>
    <mesh name="r_shoulder_pitch" file="g1/right_shoulder_pitch_link.STL"/>
    <mesh name="r_shoulder_roll"  file="g1/right_shoulder_roll_link.STL"/>
    <mesh name="r_shoulder_yaw"   file="g1/right_shoulder_yaw_link.STL"/>
    <mesh name="r_elbow"          file="g1/right_elbow_link.STL"/>
    <mesh name="r_wrist_roll"     file="g1/right_wrist_roll_link.STL"/>
    <mesh name="r_wrist_pitch"    file="g1/right_wrist_pitch_link.STL"/>
    <mesh name="r_wrist_yaw"      file="g1/right_wrist_yaw_link.STL"/>

    <!-- Left arm — visual completeness only, not part of the task action space -->
    <mesh name="l_shoulder_pitch" file="g1/left_shoulder_pitch_link.STL"/>
    <mesh name="l_shoulder_roll"  file="g1/left_shoulder_roll_link.STL"/>
    <mesh name="l_shoulder_yaw"   file="g1/left_shoulder_yaw_link.STL"/>
    <mesh name="l_elbow"          file="g1/left_elbow_link.STL"/>
    <mesh name="l_wrist_roll"     file="g1/left_wrist_roll_link.STL"/>
    <mesh name="l_wrist_pitch"    file="g1/left_wrist_pitch_link.STL"/>
    <mesh name="l_wrist_yaw"      file="g1/left_wrist_yaw_link.STL"/>
    <mesh name="l_rubber_hand"    file="g1/left_rubber_hand.STL"/>

    <!-- Rethink gripper meshes (shared with Baxter) -->
    <mesh name="standard_narrow"         file="rethink_gripper/standard_narrow.stl"/>
    <mesh name="half_round_tip"          file="rethink_gripper/half_round_tip.stl"/>
    <mesh name="electric_gripper_base_0" file="rethink_gripper/electric_gripper_base_0.obj"/>
    <mesh name="electric_gripper_base_1" file="rethink_gripper/electric_gripper_base_1.obj"/>
    <mesh name="connector_plate"         file="rethink_gripper/connector_plate.obj"/>

    <material name="gripper_mat_dark"  specular="0.5" shininess="0.25" rgba="0.001651 0.001651 0.001651 1"/>
    <material name="gripper_mat_red"   specular="0.5" shininess="0.25" rgba="0.64 0.00 0.00 1"/>
    <material name="gripper_mat_grey"  specular="0.5" shininess="0.25" rgba="0.64 0.64 0.64 1"/>
    <material name="finger_mat"        specular="0.5" shininess="0.25" rgba="0.00 0.00 0.00 1"/>
  </asset>

  <worldbody>

